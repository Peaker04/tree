# Public Expo runtime config. These values are bundled into the mobile app.
EXPO_PUBLIC_APP_ENV=development
# PHYSICAL IPHONE: use EXPO_PUBLIC_API_BASE_URL=http://<WINDOWS_LAN_IP>:3000 when using real REST backend over LAN
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Data source authority: required ('mock' or 'rest')
EXPO_PUBLIC_DATA_SOURCE=rest

# Native Android builds use this for Google Maps through react-native-maps.
# Expo Go can render maps without setting this locally.
GOOGLE_MAPS_API_KEY=

# Backend-only examples for the future API app. Do not expose these through Expo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/novyx
HERMES_AGENT_HOME=./external/hermes-agent

# Auth Configuration
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_FAILED_LOGIN_LOCK_THRESHOLD=5
AUTH_LOCK_DURATION_SECONDS=900
AUTH_SETUP_TOKEN_TTL_SECONDS=86400

# Argon2 Configuration
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Dev Seeding Auth
NOVYX_DEV_STAFF_EMAIL=staff@novyx.local
NOVYX_DEV_MANAGER_EMAIL=manager@novyx.local
NOVYX_DEV_PASSWORD= # DO NOT COMMIT REAL PASSWORDS! Set this locally before running seed.
