# Public Expo runtime config. These values are bundled into the mobile app.
EXPO_PUBLIC_APP_ENV=development
# PHYSICAL IPHONE: use EXPO_PUBLIC_API_BASE_URL=http://<WINDOWS_LAN_IP>:3000 when using real REST backend over LAN
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Native Android builds use this for Google Maps through react-native-maps.
# Expo Go can render maps without setting this locally.
GOOGLE_MAPS_API_KEY=

# API server. Defaults are shown explicitly for local development.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL two-role privilege separation.
# Fill both credentials locally; do not commit real passwords.
DATABASE_MIGRATION_URL=postgresql://<migration_user>:<migration_password>@localhost:5432/novyx
DATABASE_RUNTIME_URL=postgresql://<runtime_user>:<runtime_password>@localhost:5432/novyx

# S3-compatible evidence storage. Leave credentials empty until storage is configured.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=novyx-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Auth Configuration
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_FAILED_LOGIN_LOCK_THRESHOLD=5
AUTH_LOCK_DURATION_SECONDS=900
AUTH_SETUP_TOKEN_TTL_SECONDS=86400

# Argon2 Configuration
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Dev Seeding Auth
NOVYX_DEV_STAFF_EMAIL=staff@novyx.local
NOVYX_DEV_MANAGER_EMAIL=manager@novyx.local
NOVYX_DEV_PASSWORD=
# Required locally before `npm run db:seed:dev --workspace @novyx/api`.
