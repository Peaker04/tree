{
  "settings": {
    "toolResultRendering": "compact",
    "notifyOnStartupConnect": true,
    "directToolResultDetails": "lean"
  },
  "mcpServers": {
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      },
      "directTools": true,
      "exposeResources": true
    }
  }
}
