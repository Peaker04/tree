{
  "name": "novyx-foundation",
  "version": "0.1.0",
  "private": true,
  "main": "apps/mobile/index.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run mobile:start",
    "mobile:start": "node scripts/expo-mobile.cjs start --port 8082 --dev-client --host localhost",
    "mobile:start:ios:go": "node scripts/expo-mobile.cjs start --port 8082 --go --host lan",
    "mobile:connect:android": "node scripts/mobile-connect-android.cjs",
    "mobile:android": "node scripts/expo-mobile.cjs run:android --no-install --port 8082",
    "mobile:prebuild:android": "node scripts/expo-mobile.cjs prebuild --platform android --clean --no-install",
    "mobile:export:android": "npm run export:android --workspace @novyx/mobile",
    "mobile:export:ios": "npm run export:ios --workspace @novyx/mobile",
    "mobile:smoke:check": "node scripts/mobile-smoke-check.cjs",
    "mobile:e2e:lifecycle": "node scripts/mobile-lifecycle-e2e.cjs",
    "qr:demo": "node scripts/generate-qr-demo.cjs",
    "server:on": "node scripts/host-server.cjs on",
    "server:off": "node scripts/host-server.cjs off",
    "server:status": "node scripts/host-server.cjs status",
    "field:dev": "node scripts/field-tunnel.cjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run mobile:export:android"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@expo/ngrok": "^4.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.3",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "overrides": {
    "expo-modules-core": "~57.0.24"
  }
}
