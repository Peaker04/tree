{
  "name": "@novyx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs src/infrastructure/persistence/migrate.ts",
    "db:verify": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs src/infrastructure/persistence/verify.ts",
    "db:seed:dev": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs src/infrastructure/persistence/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@novyx/contracts": "*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3"
  }
}
