# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connections (Two-Role Privilege Separation)
# Migration/Schema Owner role: creates tables, runs migrations, has DDL privileges
DATABASE_MIGRATION_URL=postgresql://<migration_user>:<migration_password>@localhost:5432/<database>

# Runtime Application role: restricted privileges, strictly append-only on audit_events
DATABASE_RUNTIME_URL=postgresql://<runtime_user>:<runtime_password>@localhost:5432/<database>
