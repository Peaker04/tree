# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connections (Two-Role Privilege Separation)
# Migration/Schema Owner role: creates tables, runs migrations, has DDL privileges
DATABASE_MIGRATION_URL=postgresql://novyx_admin:novyx_dev_password@localhost:5432/novyx_dev

# Runtime Application role: restricted privileges, strictly append-only on audit_events
DATABASE_RUNTIME_URL=postgresql://app_runtime:app_runtime_password@localhost:5432/novyx_dev
